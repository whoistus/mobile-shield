{
  "name": "@whoistus/react-native-mobile-shield",
  "version": "0.1.0",
  "description": "In-house mobile security SDK wrapper for React Native",
  "license": "UNLICENSED",
  "private": false,
  "files": [
    "android",
    "!android/build",
    "ios",
    "MobileShield.podspec",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.72.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoistus/mobile-shield.git",
    "directory": "packages/react-native"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "test": "jest",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.72.17",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "diagnostics": false
        }
      ]
    }
  }
}
